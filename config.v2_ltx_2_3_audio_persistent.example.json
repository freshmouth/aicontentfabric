{
  "pipeline": "v2_open_source",
  "voice_provider": "elevenlabs",
  "image_provider": "openai_images",
  "video_provider": "ltx_open_source_audio",
  "lipsync_provider": "none",
  "providers": {
    "voice": ["elevenlabs"],
    "transcriber": ["local_whisper"],
    "image": ["openai_images"],
    "video": ["ltx_open_source_audio"],
    "lipsync": ["none"]
  },
  "local_whisper": {
    "runtime": "auto",
    "model": "base.en",
    "model_dir": "${LOCAL_WHISPER_MODEL_DIR}",
    "device": "cpu",
    "compute_type": "int8",
    "language": "en",
    "vad_filter": false,
    "beam_size": 5,
    "timeout_seconds": 900
  },
  "ltx_open_source_audio": {
    "endpoint_url": "LTX_AUDIO_FASTAPI_GENERATE_URL",
    "api_key_required": false,
    "request_timeout_seconds": 1800,
    "generation_timeout_seconds": 1800,
    "poll_interval_seconds": 10,
    "request_retries": 0,
    "input_wrapper": "",
    "input": {
      "generation_resolution": "1088x1920",
      "frame_rate": 25,
      "max_frames": 257,
      "num_inference_steps": 30,
      "a2v_guidance_scale": 2.0,
      "video_cfg_guidance_scale": 3.0,
      "quantization": "fp8-cast",
      "action": "generate_ltx_audio_scene"
    },
    "model": "open_source_ltx_2_3_a2vid_persistent_gpu",
    "resolution": "1080x1920",
    "min_audio_duration_seconds": 2,
    "max_audio_duration_seconds": 20,
    "max_image_data_uri_mb": 7,
    "max_audio_data_uri_mb": 15,
    "jpeg_reencode_if_large": true,
    "jpeg_quality": 92,
    "include_scene_id": true,
    "output_url_fields": ["video_url", "output_url", "download_url", "url"],
    "output_base64_fields": ["video_base64", "output_base64", "mp4_base64"]
  },
  "scene_transition": "hard_cut",
  "subtitles_enabled": true,
  "ffmpeg_timeout_seconds": 180
}
